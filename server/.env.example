PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB connection string — local MongoDB on your PC (default install, no auth)
MONGO_URI=mongodb://127.0.0.1:27017/fixnow

# JWT — used to sign login tokens. Change this to any long random string.
JWT_SECRET=fixnow_dev_secret_change_this_later
JWT_EXPIRES_IN=7d

# Razorpay — leave blank to use the demo/simulated payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Python AI microservice (see /ai-service) — used for video-frame service classification
AI_SERVICE_URL=http://localhost:8000

# AI service request timeout (ms)
AI_TIMEOUT_MS=60000

# Technician recommendation weights (tunable without a code change).
# Service/skill relevance is deliberately the largest term.
W_SERVICE_MATCH=45
W_RATING=20
W_EXPERIENCE=12
W_JOBS=10
W_PROXIMITY=8
W_AVAILABILITY=5
